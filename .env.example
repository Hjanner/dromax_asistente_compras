# --- dromax_asistente_compras · configuración local (NO se versiona) ---------
# Copia este fichero a `.env` y rellena los valores.
# Precedencia prevista: ir.config_parameter > variable de entorno > este .env

# Llave de OpenRouter (crearla con tope de crédito propio).
OPENROUTER_API_KEY=

# Niveles de modelo (slugs de openrouter.ai/models).
AI_PURCHASE_MODEL_BASIC=
AI_PURCHASE_MODEL_MEDIUM=
AI_PURCHASE_MODEL_ADVANCED=

# Usuario de solo lectura (rol dromax_ai_ro, ver scripts/create_readonly_role.sql).
# Host, puerto y base de datos son los de la propia instancia de Odoo.
AI_PURCHASE_RO_USER=dromax_ai_ro
AI_PURCHASE_RO_PASSWORD=
