<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Acceso al asistente: menú, chat, oferta, reporte y botones de compra.
             Es un grupo técnico (no sale como casilla en la ficha del usuario):
             lo reciben solos el personal de compras y los administradores, a
             través de los grupos que lo implican más abajo. Así nadie ajeno a
             compras puede tenerlo por una casilla marcada de más. -->
        <record id="group_ai_purchase_user" model="res.groups">
            <field name="name">Asistente de Compras IA</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <!-- Antes implicaba Compras; ahora es al revés (evita un ciclo). -->
            <field name="implied_ids" eval="[(3, ref('purchase.group_purchase_user'))]"/>
            <field name="comment">Puede usar el agente de compras y convertir propuestas en solicitudes de presupuesto en borrador.</field>
        </record>

        <!-- Personal de compras (Compras / Usuario; el responsable lo hereda). -->
        <record id="purchase.group_purchase_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_ai_purchase_user'))]"/>
        </record>

        <!-- Administradores (Ajustes). -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_ai_purchase_user'))]"/>
        </record>

    </data>
</odoo>
