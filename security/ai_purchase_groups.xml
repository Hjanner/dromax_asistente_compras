<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Categoría visible para que el grupo aparezca como casilla en la
             ficha del usuario. -->
        <record id="module_category_ai_purchase" model="ir.module.category">
            <field name="name">Asistente de Compras IA</field>
            <field name="description">Acceso al agente de compras: chat, propuestas y generación de borradores.</field>
            <field name="sequence">90</field>
        </record>

        <!-- Sin este grupo no se ven el menú, el chat ni los botones de compra. -->
        <record id="group_ai_purchase_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="category_id" ref="module_category_ai_purchase"/>
            <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
            <field name="comment">Puede usar el agente de compras y convertir propuestas en solicitudes de presupuesto en borrador.</field>
        </record>

    </data>
</odoo>
