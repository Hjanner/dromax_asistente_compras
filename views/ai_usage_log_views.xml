<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_usage_log_tree" model="ir.ui.view">
        <field name="name">ai.usage.log.tree</field>
        <field name="model">ai.usage.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" decoration-danger="state == 'error'">
                <field name="create_date" string="Fecha"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="level"/>
                <field name="model"/>
                <field name="task" optional="show"/>
                <field name="prompt_tokens" sum="Total" optional="show"/>
                <field name="completion_tokens" sum="Total" optional="show"/>
                <field name="total_tokens" sum="Total" optional="hide"/>
                <field name="cost" sum="Total"/>
                <field name="duration_ms" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'ok'" decoration-danger="state == 'error'"/>
            </tree>
        </field>
    </record>

    <record id="view_ai_usage_log_form" model="ir.ui.view">
        <field name="name">ai.usage.log.form</field>
        <field name="model">ai.usage.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Fecha"/>
                            <field name="user_id"/>
                            <field name="level"/>
                            <field name="task"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="model"/>
                            <field name="model_used"/>
                            <field name="provider"/>
                            <field name="generation_id"/>
                            <field name="duration_ms"/>
                        </group>
                        <group string="Tokens">
                            <field name="prompt_tokens"/>
                            <field name="cached_tokens"/>
                            <field name="completion_tokens"/>
                            <field name="reasoning_tokens"/>
                            <field name="total_tokens"/>
                        </group>
                        <group string="Costo">
                            <field name="cost"/>
                        </group>
                    </group>
                    <field name="error_message" invisible="state != 'error'" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_usage_log_pivot" model="ir.ui.view">
        <field name="name">ai.usage.log.pivot</field>
        <field name="model">ai.usage.log</field>
        <field name="arch" type="xml">
            <pivot string="Consumo de IA" sample="1">
                <field name="create_date" interval="month" type="row"/>
                <field name="level" type="col"/>
                <field name="cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ai_usage_log_graph" model="ir.ui.view">
        <field name="name">ai.usage.log.graph</field>
        <field name="model">ai.usage.log</field>
        <field name="arch" type="xml">
            <graph string="Consumo de IA" type="bar" stacked="1" sample="1">
                <field name="create_date" interval="day"/>
                <field name="level"/>
                <field name="cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_ai_usage_log_search" model="ir.ui.view">
        <field name="name">ai.usage.log.search</field>
        <field name="model">ai.usage.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="model"/>
                <field name="task"/>
                <filter name="filter_this_month" string="Este mes"
                        domain="[('create_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_create_date" date="create_date"/>
                <separator/>
                <filter name="filter_error" string="Con error" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_level" string="Nivel" context="{'group_by': 'level'}"/>
                    <filter name="group_model" string="Modelo" context="{'group_by': 'model'}"/>
                    <filter name="group_user" string="Usuario" context="{'group_by': 'user_id'}"/>
                    <filter name="group_task" string="Tarea" context="{'group_by': 'task'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_usage_log" model="ir.actions.act_window">
        <field name="name">Consumo de IA</field>
        <field name="res_model">ai.usage.log</field>
        <field name="view_mode">tree,pivot,graph,form</field>
        <field name="context">{'search_default_filter_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay llamadas al modelo</p>
            <p>Cada llamada a OpenRouter queda registrada aquí con su nivel, sus tokens y su costo.</p>
        </field>
    </record>

</odoo>
