<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cancelar varias solicitudes de presupuesto desde la lista de Compras (botón
         «Cancelar solicitudes» o Acciones → Cancelar solicitudes). -->
    <record id="view_ai_purchase_cancel_form" model="ir.ui.view">
        <field name="name">ai.purchase.cancel.form</field>
        <field name="model">ai.purchase.cancel</field>
        <field name="arch" type="xml">
            <form string="Cancelar solicitudes">
                <field name="order_ids" invisible="1"/>
                <p invisible="not to_cancel_count">
                    Se cancelarán <b><field name="to_cancel_count" class="oe_inline"/></b> solicitudes de presupuesto.
                    Quedan en la lista como canceladas; si hace falta, se pueden volver a borrador desde su ficha.
                </p>
                <p invisible="to_cancel_count" class="text-warning">
                    Ninguna de las elegidas es una solicitud de presupuesto: ya están confirmadas o canceladas.
                </p>
                <p invisible="not skipped_count" class="text-muted">
                    <field name="skipped_count" class="oe_inline"/> ya son órdenes confirmadas o están canceladas
                    y no se tocan (una orden confirmada se cancela desde su ficha).
                </p>
                <field name="to_cancel_ids" invisible="not to_cancel_count" readonly="1">
                    <tree>
                        <field name="name"/>
                        <field name="partner_id" string="Proveedor"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="ai_a_nombre_de_id" groups="base.group_multi_company" optional="show"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="amount_total" sum="Total"/>
                        <field name="state" widget="badge"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Cancelar solicitudes"
                            class="btn-primary" invisible="not to_cancel_count"/>
                    <button string="Volver" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ai_purchase_cancel" model="ir.actions.act_window">
        <field name="name">Cancelar solicitudes</field>
        <field name="res_model">ai.purchase.cancel</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(6, 0, [ref('purchase.group_purchase_user')])]"/>
    </record>

    <!-- Botón a la vista en la lista de Solicitudes de presupuesto (aparece al marcar filas). -->
    <record id="purchase_order_kpis_tree_cancel" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.cancel</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ai_cancel_rfqs" type="object" string="Cancelar solicitudes"
                        groups="purchase.group_purchase_user"/>
            </xpath>
        </field>
    </record>
</odoo>
